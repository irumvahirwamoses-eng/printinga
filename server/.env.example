NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# On Render, leave CLIENT_URL unset: it is derived from RENDER_EXTERNAL_HOSTNAME.

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/schoolprint
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# lax for same-origin (Vite proxy locally / single Render service).
COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEED_OFFICER_NATIONAL_ID=0000000000000001
SEED_OFFICER_PASSWORD=change-this-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@schoolprint.local
