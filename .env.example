# Copy to server/.env for local development. Do not commit real values.

# === Server ===
NODE_ENV=development
PORT=5000
# Local dev: Vite runs on 5173. On Render this is derived automatically from
# RENDER_EXTERNAL_HOSTNAME, so you do not need to set it there.
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/schoolprint?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Same-origin deployments (local Vite proxy + single Render service)
COOKIE_SAME_SITE=lax
# Use COOKIE_SAME_SITE=none ONLY when the client and API are on different sites.

# Required in production (Render's filesystem is ephemeral).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email for forgot-password links. Without it, links are logged to
# the server console in development and never returned by the API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@schoolprint.local

# First officer seed (only used when no officer exists).
SEED_OFFICER_NATIONAL_ID=0000000000000001
SEED_OFFICER_PASSWORD=change-this-password

# === Client (optional) ===
# Leave both blank for the single-service setup — the built app calls '/api'
# and connects to the socket on the same origin.
VITE_API_URL=
VITE_SOCKET_URL=
