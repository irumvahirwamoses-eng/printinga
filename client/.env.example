# Leave both blank for local development (Vite proxies /api and /socket.io to
# localhost:5000) and for production on Render (client and API share an origin).
VITE_API_URL=
VITE_SOCKET_URL=

# Only set these when the frontend is hosted separately from the API:
# VITE_API_URL=https://your-api.onrender.com/api
# VITE_SOCKET_URL=https://your-api.onrender.com
